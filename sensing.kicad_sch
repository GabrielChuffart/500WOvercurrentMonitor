	(text_box "CURRENT SENSOR U401 ACS781LLRTR-050B-T\n\nVOUT = VCC/2 + S x I, S = 26.4mV/A at VCC = 3.3V.\n\nLoad range [-3;+25]A -> VOUT [1.571;2.310]V.\n\nC401 100nF bypass, cf datasheet.\n\nR401 100k pull-down: sensor unpowered or VOUT open -> VOUT = 0V -> sensor-fault failsafe"
		(exclude_from_sim no)
		(at 16.51 54.61 0)
		(size 59.69 24.3946)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type solid)
		)
		(fill
			(type none)
		)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "247cd4b3-853b-4e23-a5a7-ef7ce215c371")
	)
	(text_box "TEST BUTTON SW401/R403\n\nPressed: V_SENSE = (1.65/10k + 3.3/1k) / (1/10k + 1/1k) = 3.15V > V_eq 1.880V -> trip.\n\nTests comparator A, latch, coil driver and relay."
		(exclude_from_sim no)
		(at 100.33 14.7593 0)
		(size 34.29 18.2607)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type solid)
		)
		(fill
			(type none)
		)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "4b4925be-4f34-4909-8f26-6429d55e78b7")
	)
	(text_box "INPUT FILTER R402/C402\n\nfc = 1 / (2 pi x 10k x 15nF) = 1.06kHz, tau = 150us.\n\nSensor noise 36mVpp (1.4App) at 120 kHz bandwidth -> ~3.4mVpp (0.13App) after filter.\n\nR402 isolates C402 from VOUT (cf datasheet: max 10nF directly on VOUT).\n"
		(exclude_from_sim no)
		(at 77.47 54.61 0)
		(size 59.69 20.32)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type solid)
		)
		(fill
			(type none)
		)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "d2d73fbb-40d7-4488-bbc6-2239beb78948")
	)
